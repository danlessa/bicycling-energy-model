# paper1-closed-form.meta.ttl — claim annotations for paper1-closed-form.md
#
# Each published statistic in the article carries an invisible anchor at the
# number, <!--@c-<id>-->, and is described here as a schema:Claim keyed to that
# id. The metadata lives OUT of the prose for four reasons:
#
#   1. it is a first-class .ttl, so it inherits the repo's existing rule that
#      every Turtle file is validated with rdflib after editing;
#   2. it composes directly with claims.ttl and data-graph.ttl — the three can
#      be loaded into one graph and queried together;
#   3. human drafters editing prose cannot corrupt it. Inline blocks lived in
#      HTML comments, where a reflowed paragraph or a stray double hyphen closes
#      the comment early and silently eats the annotation;
#   4. it survives a format change. The human draft may not stay markdown; an
#      inline HTML comment does not follow it to LaTeX or a word processor, a
#      sidecar keyed by id does. If the anchors are lost in such a move, the
#      claims are still fully described here and can be re-anchored — which is
#      why every claim carries schema:text.
#
# Validate: python3 -c "import rdflib; rdflib.Graph().parse('research/article/paper1-closed-form.meta.ttl')"
# Checked by research/scripts/check_paper_stats.py

@prefix schema:  <http://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix cito:    <http://purl.org/spar/cito/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix pc:      <https://danlessa.github.io/bicycling-energy-model/paper-claims#> .
@prefix dg:      <https://danlessa.github.io/bicycling-energy-model/data-graph#> .
@prefix claims:  <https://danlessa.github.io/bicycling-energy-model/claims#> .

<#c-d6.f3d.med> a schema:Claim ;
  schema:text "D6 F3 eps_d median |D%| 3.16 against the simulation's 3.15, on 740 clean rides" ;
  dcterms:type "external" ;
  pc:value 3.16 ;
  pc:gateSection "3j" ;
  cito:citesAsEvidence dg:o_skc ;
  prov:wasDerivedFrom claims:assert43 ;
  rdfs:comment "The only corpus sharing no rider, country, terrain, device or model-selection history" ;
  pc:preRegistered true .

<#c-e46.ag.switched.med> a schema:Claim ;
  schema:text "Applying section 3.3's regime switch under frozen priors moves the pooled median 5.08 -> 5.62" ;
  dcterms:type "in-sample" ;
  pc:value 5.62 ;
  pc:gateSection "3m" ;
  cito:citesAsEvidence dg:o_e46 ;
  prov:wasDerivedFrom claims:assert46 ;
  rdfs:comment "The switch makes the FROZEN grid worse; under per-ride inverted physics it makes it better. The bias column adjudicates" ;
  pc:preRegistered true .

<#c-e46.eps_applied.sub3> a schema:Claim ;
  schema:text "Median eps_d actually applied below the 3% gate is 0.544, against eps_f = 0.20" ;
  dcterms:type "in-sample" ;
  pc:value 0.544 ;
  pc:gateSection "3m" ;
  cito:citesAsEvidence dg:o_e46 ;
  prov:wasDerivedFrom claims:assert46 ;
  rdfs:comment "Why the frozen sub-threshold cells are accurate BY CANCELLATION rather than by fit" ;
  pc:preRegistered true .

<#c-d1.f3.informed.med> a schema:Claim ;
  schema:text "F3 median |D%| 3.5 [2.0, 5.6] on D1 under condition-informed per-ride parameters" ;
  dcterms:type "calibration" ;
  pc:value 3.5 ;
  pc:gateSection "1" ;
  cito:citesAsEvidence dg:o_model_comparison ;
  rdfs:comment "The CALIBRATION ceiling, not a transfer result: every tunable was fixed on this corpus and the informed run additionally hand-chose a per-ride epsilon" .

<#c-pool34.f3d.med> a schema:Claim ;
  schema:text "F3 eps_d median |D%| 5.6 [5.2, 6.2] on the D3+D4 transfer pool, n = 660" ;
  dcterms:type "out-of-sample" ;
  pc:value 5.6 ;
  pc:gateSection "3c" ;
  cito:citesAsEvidence dg:o_ppaz, dg:o_jaam ;
  prov:wasDerivedFrom claims:assert12 ;
  rdfs:comment "THE headline transfer figure. Neither corpus took part in any model selection" .

<#c-pool34.tost> a schema:Claim ;
  schema:text "TOST 90% CI of the median difference, law minus simulation: [-0.90, -0.33] pp, inside the +/-1.0 margin" ;
  dcterms:type "out-of-sample" ;
  pc:value -0.63 ;
  pc:gateSection "3n" ;
  cito:citesAsEvidence dg:o_e48 ;
  prov:wasDerivedFrom claims:assert48 ;
  rdfs:comment "Formal equivalence, not a failure to reject; the interval sits on the side where the law is better" ;
  pc:preRegistered true .


<#c-d1.f4.informed.med> a schema:Claim ;
  schema:text "F4 median |D%| 5.9 on D1, condition-informed parameters" ;
  dcterms:type "calibration" ;
  pc:value 5.9 ;
  pc:gateSection "1" ;
  cito:citesAsEvidence dg:o_model_comparison .

<#c-d1.sim.informed.med> a schema:Claim ;
  schema:text "Forward simulation median |D%| 5.2 on D1, same informed parameters" ;
  dcterms:type "calibration" ;
  pc:value 5.2 ;
  pc:gateSection "1" ;
  cito:citesAsEvidence dg:o_model_comparison .

<#c-d1.f1.uncorrected.med> a schema:Claim ;
  schema:text "Uncorrected F1 median |D%| 19.1 on D1 - the baseline the two corrections act on" ;
  dcterms:type "calibration" ;
  pc:value 19.1 ;
  pc:gateSection "1" ;
  cito:citesAsEvidence dg:o_model_comparison .

<#c-d1.f2.split.med> a schema:Claim ;
  schema:text "F2, aero gated off climbs only, median |D%| 8.6" ;
  dcterms:type "calibration" ;
  pc:value 8.6 ;
  pc:gateSection "1" ;
  cito:citesAsEvidence dg:o_model_comparison .

<#c-d1.parity.signtest> a schema:Claim ;
  schema:text "Paired sign test law vs simulation on D1, p = 0.65 - no detectable difference" ;
  dcterms:type "calibration" ;
  pc:value 0.65 ;
  pc:gateSection "1" ;
  cito:citesAsEvidence dg:o_model_comparison .

<#c-d1.blind.f3.med> a schema:Claim ;
  schema:text "F3 median |D%| 8.2 on D1 under the FROZEN protocol - the blind coherence check" ;
  dcterms:type "calibration" ;
  pc:value 8.2 ;
  pc:gateSection "1b" ;
  cito:citesAsEvidence dg:o_longoes_frozen .

<#c-d2.f3.med> a schema:Claim ;
  schema:text "F3 eps_d median |D%| 7.7 on the urban corpus, nothing refit" ;
  dcterms:type "out-of-sample" ;
  pc:value 7.7 ;
  pc:gateSection "2" ;
  cito:citesAsEvidence dg:o_censo .

<#c-d2.tost.worse> a schema:Claim ;
  schema:text "D2 is the one parity claim TOST declines to support: CI [-0.04, +2.18] allows the law being 2.2 pp worse" ;
  dcterms:type "out-of-sample" ;
  pc:value 1.08 ;
  pc:gateSection "3n" ;
  cito:citesAsEvidence dg:o_e48 .




<#c-pool.regime.f3d> a schema:Claim ;
  schema:text "Under regime-consistent per-ride aero the pool reaches 3.9 - partially in-sample per ride by construction" ;
  dcterms:type "in-sample" ;
  pc:value 3.9 ;
  pc:gateSection "3e" ;
  cito:citesAsEvidence dg:o_perride_invert .

<#c-pool.regime.sim> a schema:Claim ;
  schema:text "Simulation under the same per-ride physics, 4.0 - the pairing restored" ;
  dcterms:type "in-sample" ;
  pc:value 4.0 ;
  pc:gateSection "3e" ;
  cito:citesAsEvidence dg:o_perride_invert .


<#c-e50.eps.share> a schema:Claim ;
  schema:text "eps accounts for 0.070 of F3 prediction-error variance (total-order Sobol index), against 0.553 for CdA" ;
  dcterms:type "derived" ;
  pc:value 0.070 ;
  pc:gateSection "3p" ;
  cito:citesAsEvidence dg:o_e50 ;
  pc:preRegistered true ;
  rdfs:comment "The measurement that moved the deficit theory out of paper 1 and into section 4.4.2 as future work" .

# ---------------------------------------------------------------------------
# Entry 52 — the A-chain. One protocol (P_f,r), one random split of D3-D6,
# forms selected by cross-validation on the training half and scored once on
# the held-out 305. These replace the frozen-grid claims retired above, whose
# prose went with section 3.3's rewrite: that section reported a protocol the
# paper no longer runs, and Entry 50 showed why -- eps is ~7% of the error
# variance, so a frozen-constant table measured how wrong the assumed constants
# were rather than how good the law is.

<#c-e52.f3.med> a schema:Claim ;
  schema:text "F3 median |D%| 3.98 [3.51, 4.54] on the held-out half of D3-D6, n = 305" ;
  dcterms:type "out-of-sample" ;
  pc:value 3.98 ;
  pc:gateSection "3q" ;
  cito:citesAsEvidence dg:o_ppaz, dg:o_jaam, dg:o_danlessa, dg:o_skc ;
  prov:wasDerivedFrom claims:assert12 ;
  rdfs:comment "THE headline. Rides used neither to fit eps nor to choose the form. Held out in eps and form, NOT in the per-ride constants -- the inversion is data preparation and runs before the split" .

<#c-e52.f3.bias> a schema:Claim ;
  schema:text "F3 median signed D% -1.06 [-1.56, -0.37] on the held-out half of D3-D6" ;
  dcterms:type "out-of-sample" ;
  pc:value -1.06 ;
  pc:gateSection "3q" ;
  cito:citesAsEvidence dg:o_ppaz, dg:o_jaam, dg:o_danlessa, dg:o_skc ;
  prov:wasDerivedFrom claims:assert12 ;
  rdfs:comment "Paired with the accuracy figure per the house rule: accuracy alone hides bias cancellation" .

<#c-e52.fbase.med> a schema:Claim ;
  schema:text "F_base median |D%| 5.71 [5.13, 6.42] on the same held-out half, as a comparator outside selection" ;
  dcterms:type "out-of-sample" ;
  pc:value 5.71 ;
  pc:gateSection "3q" ;
  cito:citesAsEvidence dg:o_ppaz, dg:o_jaam, dg:o_danlessa, dg:o_skc ;
  prov:wasDerivedFrom claims:assert12 ;
  rdfs:comment "NOT a claim that the closed form is better physics. The gap is concentrated in the three Sao Paulo corpora and traces to the inversion fitting constants on sustained segments the simulation then leaves" .

<#c-e52.eps> a schema:Claim ;
  schema:text "the descent constant refits to eps = 0.288 on the training half, against 0.255 on the test half's own optimum" ;
  dcterms:type "out-of-sample" ;
  pc:value 0.288 ;
  pc:gateSection "3q" ;
  cito:citesAsEvidence dg:o_ppaz, dg:o_jaam, dg:o_danlessa, dg:o_skc ;
  prov:wasDerivedFrom claims:assert12 ;
  rdfs:comment "The two-way agreement is the identifiability check: the constant is a property of the data, not of which rides were drawn" .

<#c-e52.twin> a schema:Claim ;
  schema:text "82% of held-out rides have a same-rider training ride within 5% on distance and 10% on ascent" ;
  dcterms:type "out-of-sample" ;
  pc:value 82 ;
  pc:gateSection "3q" ;
  cito:citesAsEvidence dg:o_ppaz, dg:o_jaam, dg:o_danlessa, dg:o_skc ;
  prov:wasDerivedFrom claims:assert12 ;
  rdfs:comment "The exposure a random split carries, measured rather than assumed away. 3.98 is a repeat-route error" .
